---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieLista from '../components/CookieLista.astro';

interface Props {
  title: string;
  description?: string;
  /** Absolutní cesta k OG obrázku 1200×630 v /public, např. "/plany/dopaminovy-detox/og.png". */
  image?: string;
  /** Stránky, které nemají být v indexu (děkovačky). Sitemapa je filtruje v astro.config.mjs. */
  noindex?: boolean;
}

const {
  title,
  description = 'Pravidla výzev bez nejasností, rozpis na každý den a tracker k vytištění. Česky a zdarma.',
  image,
  noindex = false,
} = Astro.props;

const ogImage = image ? new URL(image, Astro.site).toString() : undefined;

const canonical = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://budujsamsebe.cz/#organization',
      name: 'Buduj sám sebe',
      url: 'https://budujsamsebe.cz/',
    },
    {
      '@type': 'WebSite',
      '@id': 'https://budujsamsebe.cz/#website',
      name: 'Buduj sám sebe',
      url: 'https://budujsamsebe.cz/',
      inLanguage: 'cs',
      publisher: { '@id': 'https://budujsamsebe.cz/#organization' },
    },
  ],
};
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" href="/favicon.ico" sizes="48x48 32x32 16x16" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f4f2ec" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content="Buduj sám sebe" />
    {
      ogImage ? (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={ogImage} />
        </>
      ) : (
        <meta name="twitter:card" content="summary" />
      )
    }
    <!-- TODO výchozí og:image pro celý web: vyrob /public/og.png (1200×630) a dej `image="/og.png"` jako default výše. -->

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=IBM+Plex+Mono:wght@400;600&display=swap"
    />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <!-- Stránkové <head> doplňky (např. FAQPage schema): <… slot="head" /> -->
    <slot name="head" />
  </head>
  <body class="bg-paper font-sans text-ink antialiased">
    <Header />
    <slot />
    <Footer />
    <CookieLista />
  </body>
</html>
