---
/**
 * Cookie lišta + načtení Google Analytics 4 až po souhlasu.
 * GA4_ID doplň, až založíš property (Admin → Datové streamy → ID měření, tvar G-XXXXXXXXXX).
 * Dokud je prázdné, lišta se zobrazuje, ale nic se neměří.
 */
const GA4_ID = '';
---

<div
  id="cookie-lista"
  hidden
  class="fixed inset-x-0 bottom-0 z-50 border-t-[3px] border-ink bg-paper"
  role="dialog"
  aria-labelledby="cookie-lista-h"
>
  <div
    class="mx-auto flex max-w-5xl flex-col gap-4 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-8"
  >
    <div class="flex flex-col gap-1">
      <div id="cookie-lista-h" class="font-mono text-[12px] font-semibold tracking-[0.1em] text-accent">
        MĚŘENÍ NÁVŠTĚVNOSTI
      </div>
      <p class="max-w-xl text-sm leading-relaxed text-ink-soft">
        Rádi bychom anonymně měřili, které stránky lidem pomáhají (Google Analytics). Bez souhlasu
        se nic neměří a web funguje stejně.
        <a href="/ochrana-osobnich-udaju/" class="underline decoration-accent decoration-2 hover:text-accent"
          >Jak s údaji nakládáme</a
        >.
      </p>
    </div>
    <div class="flex shrink-0 gap-3">
      <button
        type="button"
        data-cookie="deny"
        class="border-2 border-ink px-4 py-2.5 font-mono text-[12px] font-semibold tracking-[0.04em] hover:border-accent hover:text-accent"
      >
        NEMĚŘIT
      </button>
      <button
        type="button"
        data-cookie="grant"
        class="bg-ink px-4 py-2.5 font-mono text-[12px] font-semibold tracking-[0.04em] text-paper hover:bg-accent"
      >
        SOUHLASÍM
      </button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ GA4_ID }}>
  (function () {
    var KEY = 'bss-cookies-v1';
    var lista = document.getElementById('cookie-lista');
    if (!lista) return;
    function read() {
      try {
        return localStorage.getItem(KEY);
      } catch (e) {
        return null;
      }
    }
    function write(v) {
      try {
        localStorage.setItem(KEY, v);
      } catch (e) {
        /* soukromý režim — lišta se zobrazí příště znovu, nevadí */
      }
    }
    function loadGa() {
      if (!GA4_ID || window.__gaLoaded) return;
      window.__gaLoaded = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.gtag('js', new Date());
      window.gtag('config', GA4_ID, { anonymize_ip: true });
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(GA4_ID);
      document.head.appendChild(s);
    }
    function show() {
      lista.hidden = false;
    }
    function hide() {
      lista.hidden = true;
    }
    lista.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-cookie]');
      if (!btn) return;
      var v = btn.getAttribute('data-cookie');
      write(v);
      hide();
      if (v === 'grant') loadGa();
    });
    var stav = read();
    if (stav === 'grant') loadGa();
    else if (stav !== 'deny') show();
    // odkaz „Nastavení cookies“ v patičce lištu znovu otevře
    document.querySelectorAll('[data-cookie-open]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        show();
      });
    });
  })();
</script>
