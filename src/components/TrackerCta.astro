---
interface Props {
  label?: string;
  title?: string;
  href?: string;
  cta?: string;
}
const {
  label = 'TRACKER NA 75 DNÍ',
  title = 'Vytiskni si checklist a odškrtávej',
  href = '/tracker/',
  cta = 'STÁHNOUT PDF →',
} = Astro.props;
---

<div class="flex flex-col gap-4 bg-ink p-6 text-paper sm:flex-row sm:items-center sm:justify-between">
  <div class="flex flex-col gap-1">
    <div class="font-mono text-[12px] tracking-[0.1em] text-accent-soft">{label}</div>
    <div class="text-lg font-bold">{title}</div>
  </div>
  <a
    href={href}
    class="inline-block whitespace-nowrap bg-accent px-5 py-3.5 font-mono text-[13px] font-semibold tracking-[0.04em] text-paper hover:bg-paper hover:text-ink"
    >{cta}</a
  >
</div>
