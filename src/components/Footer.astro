---
import { getCollection } from 'astro:content';
import ZnamkovaDolozka from './ZnamkovaDolozka.astro';
import { serazenePodleData } from '../lib/vyzvy';

const year = new Date().getFullYear();
const vyzvy = serazenePodleData(await getCollection('vyzvy')).slice(0, 5);

const sloupce = [
  {
    label: 'VÝZVY',
    odkazy: [
      ...vyzvy.map((post) => ({ href: `/vyzvy/${post.id}/`, label: post.data.title })),
      { href: '/vyzvy/', label: 'Všechny výzvy' },
    ],
  },
  {
    label: 'PLÁNY',
    odkazy: [
      { href: '/plany/dopaminovy-detox/', label: 'Dopaminový detox: 7denní plán' },
      { href: '/plany/75-dni/', label: '75 DNÍ po česku' },
      { href: '/plany/', label: 'Všechny plány' },
    ],
  },
  {
    label: 'WEB',
    odkazy: [
      { href: '/o-nas/', label: 'O nás a zdrojích' },
      { href: '/tracker/', label: 'Tracker zdarma' },
      { href: '/nastroje/dopaminovy-rozpocet/', label: 'Kalkulačka: dopaminový rozpočet' },
      { href: '/obchodni-podminky/', label: 'Obchodní podmínky' },
      { href: '/ochrana-osobnich-udaju/', label: 'Ochrana osobních údajů' },
      { href: '#', label: 'Nastavení cookies', cookie: true },
    ],
  },
];
---

<footer class="mt-16 border-t-[3px] border-ink">
  <div class="mx-auto grid max-w-5xl grid-cols-1 gap-8 px-5 py-10 sm:grid-cols-3 sm:px-8">
    {
      sloupce.map((sloupec) => (
        <div class="flex flex-col gap-3">
          <div class="font-mono text-[12px] font-semibold tracking-[0.12em] text-accent">
            {sloupec.label}
          </div>
          <ul class="flex flex-col gap-2">
            {sloupec.odkazy.map((odkaz) => (
              <li>
                <a
                  href={odkaz.href}
                  data-cookie-open={'cookie' in odkaz ? '' : undefined}
                  class="font-mono text-[13px] leading-snug text-ink-soft hover:text-accent"
                >
                  {odkaz.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="border-t border-line">
    <div class="mx-auto flex max-w-5xl flex-col gap-2 px-5 py-6 font-mono text-[12px] leading-relaxed text-muted sm:flex-row sm:items-center sm:justify-between sm:px-8">
      <div>© {year} budujsamsebe.cz — výzvy a plány</div>
      <div>Obsah není lékařská rada; zdroje uvádíme u článků.</div>
    </div>
    <div class="mx-auto max-w-5xl px-5 pb-6 sm:px-8">
      <ZnamkovaDolozka />
    </div>
  </div>
</footer>
