---
import Base from '../layouts/Base.astro';
import EcomailForm from '../components/EcomailForm.astro';
---

<Base
  title="Tracker na 75 dní (k výzvě známé jako 75 Hard) — PDF zdarma — Buduj sám sebe"
  description="Tisknutelný tracker k výzvě známé jako 75 Hard: pět pravidel na každý den, týdenní přehled a milníky na 4 stranách A4. Zdarma do e-mailu."
>
  <main>
    <section class="border-b-[3px] border-ink">
      <div class="mx-auto flex max-w-3xl flex-col gap-5 px-5 py-12 sm:px-8">
        <div class="font-mono text-[12px] font-semibold tracking-[0.12em] text-accent">
          KE STAŽENÍ ZDARMA
        </div>
        <h1 class="text-3xl font-bold leading-[1.1] sm:text-[44px]">
          Tracker na 75 dní:<br />odškrtej každé políčko
        </h1>
        <p class="max-w-lg font-mono text-sm leading-relaxed">
          Tisknutelné PDF k výzvě známé jako 75 Hard: čtyři strany A4 — pravidla, milníky, týdenní
          přehled a 75 řádků s políčky na jídlo, dva tréninky, vodu, deset stránek a fotku. Pošleme
          ho na e-mail.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-3xl px-5 py-10 sm:px-8">
      <div class="border-[3px] border-ink p-6">
        <div class="mb-4 font-mono text-[12px] tracking-[0.1em] text-muted">
          PDF ZDARMA DO E-MAILU
        </div>
        <EcomailForm magnet="tracker-75" cta="CHCI TRACKER ZDARMA →" />
        <div class="mt-3 font-mono text-[11px] leading-relaxed text-muted">
          Zadáš jméno a e-mail, PDF přijde do minuty. Nic jiného ti posílat nebudeme.
        </div>
      </div>

      <div class="mt-8 flex flex-col gap-4 border-[3px] border-ink bg-paper-dark p-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="max-w-md">
          <div class="font-mono text-[12px] tracking-[0.1em] text-muted">KDYŽ NECHCEŠ SKLÁDAT POSTUP SÁM</div>
          <div class="mt-1 text-lg font-bold">75 DNÍ po česku — kompletní plán</div>
          <p class="mt-2 font-mono text-[12px] leading-relaxed text-ink-soft">
            Tracker je tabulka. Plán je jedenáct týdenních kapitol, jídelníčky, tréninky
            a krizové dny 10–20. Tracker a karty pravidel jsou v ceně.
          </p>
        </div>
        <a
          href="/plany/75-dni/"
          class="shrink-0 bg-ink px-5 py-4 text-center font-mono text-[13px] font-semibold tracking-[0.04em] text-paper hover:bg-accent"
          >PLÁN ZA 249 KČ →</a
        >
      </div>
    </section>
  </main>
</Base>
