---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CheckItem from '../components/CheckItem.astro';
import { serazenePodleData } from '../lib/vyzvy';

const clanky = await getCollection('vyzvy');
const existujici = new Set(clanky.map((post) => post.id));
const nejnovejsi = serazenePodleData(clanky).slice(0, 6);

/** Mini-huby. Odkazy se filtrují proti kolekci — nevypsaný slug = ještě nenapsaný článek. */
const huby = [
  {
    num: '01',
    title: 'Výzva 75 Hard',
    desc: 'Nejtvrdší výzva současnosti: 5 pravidel, 75 dní, žádné výjimky.',
    odkazy: [
      { slug: '75-hard-pravidla', label: 'Pravidla 75 Hard přehledně' },
      { slug: '75-hard-jidelnicek', label: 'Jídelníček z českých potravin' },
      { slug: '75-hard-chyby', label: 'Proč 80 % lidí nedokončí: 7 chyb' },
      { slug: '75-soft', label: '75 Soft: měkčí verze' },
    ],
  },
  {
    num: '02',
    title: 'Dopaminový detox',
    desc: '7 dní bez bezmyšlenkovitého scrollování. Restart pozornosti.',
    odkazy: [
      { slug: 'dopaminovy-detox', label: 'Co je dopaminový detox' },
      { slug: 'dopaminovy-detox-plan', label: '7denní rozpis den po dni' },
    ],
  },
  {
    num: '03',
    title: 'Rucking',
    desc: 'Vezmi batoh, přidej zátěž, jdi. Síla z chůze.',
    odkazy: [
      { slug: 'rucking', label: 'Co je rucking a jak začít' },
      { slug: 'rucking-plan', label: '12týdenní plán od nuly' },
    ],
  },
].map((hub) => ({
  ...hub,
  odkazy: hub.odkazy.filter((odkaz) => existujici.has(odkaz.slug)),
}));

const kroky = [
  {
    num: '01',
    title: 'VYBER',
    desc: 'Výzvu, která dává smysl tvému životu. Ne tu, co frčí na internetu — tu, kterou dokážeš dokončit.',
  },
  {
    num: '02',
    title: 'VYTISKNI',
    desc: 'Stáhni tracker, vytiskni ho a dej na lednici. Co visí na zdi, to se plní.',
  },
  {
    num: '03',
    title: 'ODŠKRTÁVEJ',
    desc: 'Den za dnem. Čárka je čárka — a člověk, který udělá sedmdesátou pátou, je jiný než ten, který udělal první.',
  },
];

const faq = [
  {
    q: 'Co je výzva 75 Hard?',
    a: '75 Hard je 75denní výzva mentální odolnosti od Andyho Friselly. Každý den držíš zvolený jídelníček bez alkoholu, absolvuješ dva 45minutové tréninky, vypiješ přibližně 3,8 litru vody, přečteš 10 stran naučné knihy a pořídíš progresovou fotku. Autor ji popisuje jako trénink disciplíny, ne jako běžný fitness program.',
  },
  {
    q: 'Jaká jsou pravidla 75 Hard?',
    a: 'Pět denních úkolů je pevně daných: zvolený jídelníček bez alkoholu a volných jídel, 2× 45 minut pohybu s jedním tréninkem venku, jeden galon vody, 10 stran naučné knihy a progresová fotka. Podrobný český přehled vysvětluje i sporné situace a to, co se do výzvy počítá.',
  },
  {
    q: 'Je 75 Hard zdarma?',
    a: 'Ano. Pravidla 75 Hard jsou veřejná a náš český tracker si stáhneš zdarma. Placený kompletní plán může přípravu usnadnit, ale k zahájení ani dokončení výzvy ho nepotřebuješ.',
  },
  {
    q: 'Co když jeden den vynechám?',
    a: 'Podle pravidel začínáš od dne 1. Žádné výjimky — právě proto výzva funguje. Jestli ti to přijde moc, začni s 75 Soft.',
  },
  {
    q: 'Co je 75 Soft?',
    a: '75 Soft je volnější alternativa inspirovaná výzvou 75 Hard. Běžně pracuje s vyváženým jídelníčkem, jedním 45minutovým tréninkem denně, třemi litry vody a každodenním čtením. Na internetu existuje více variant, proto je dobré si předem zapsat přesná pravidla, která budeš držet.',
  },
  {
    q: 'Jak si vybrat jídelníček pro 75 Hard?',
    a: 'Oficiální pravidla nepředepisují konkrétní dietu. Vyber si předem jasný a realistický způsob stravování odpovídající tvému cíli a zdravotnímu stavu. Pravidla si napiš tak, aby během výzvy nevznikaly výjimky podle nálady. Extrémní dietu nebo velký kalorický deficit konzultuj s odborníkem.',
  },
  {
    q: 'Co je dopaminový detox a funguje?',
    a: 'Dopaminový detox neodstraňuje dopamin z těla ani „neresetuje“ mozek. Je to nepřesný, ale rozšířený název pro dočasné omezení rychlých podnětů, jako jsou notifikace, sociální sítě nebo krátká videa. Smyslem je všimnout si automatických návyků a znovu získat kontrolu nad pozorností.',
  },
  {
    q: 'Jak dlouho má dopaminový detox trvat?',
    a: 'Začít můžeš několika hodinami bez rušivých aplikací nebo jedním klidnějším večerem. Náš 7denní plán přidává změny postupně, aby z něj nebyl extrémní zákaz všeho příjemného, ale praktický test digitálních návyků.',
  },
  {
    q: 'Co je rucking a jak začít?',
    a: 'Rucking je svižná chůze se zátěží v batohu. Začni pohodlnou trasou a lehkým nákladem, který v batohu pevně zajistíš. Nejdřív přidávej čas nebo vzdálenost a teprve potom váhu. Potřebuješ hlavně pevný batoh, pohodlné boty a postupný začátek.',
  },
  {
    q: 'Potřebuju speciální vybavení?',
    a: 'Na 75 Hard většinou stačí vhodné boty, kniha a způsob, jak si vést tracker. Pro první rucking nepotřebuješ speciální zátěžový batoh: použít lze pevný turistický batoh a dobře zajištěné lahve s vodou nebo jinou lehkou zátěž.',
  },
  {
    q: 'Je to bezpečné?',
    a: 'Záleží na tvém zdraví a výchozí kondici. Vysoký příjem vody, dva tréninky denně ani chůze se zátěží nemusí vyhovovat každému. Pokud máš zdravotní omezení, bereš léky nebo se vracíš po zranění, prober začátek s lékařem či fyzioterapeutem. Náš obsah není lékařská rada.',
  },
];

const porovnani = [
  {
    nazev: '75 Hard',
    delka: '75 dní',
    zamer: 'Disciplína a důslednost',
    start: 'Pravidla + tracker',
    href: '/vyzvy/75-hard-pravidla/',
  },
  {
    nazev: 'Dopaminový detox',
    delka: '7 dní',
    zamer: 'Pozornost a digitální návyky',
    start: 'Postupné omezení podnětů',
    href: '/plany/dopaminovy-detox/',
  },
  {
    nazev: 'Rucking',
    delka: 'Průběžně',
    zamer: 'Kondice při chůzi',
    start: 'Pevný batoh + lehká zátěž',
    href: undefined,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((polozka) => ({
    '@type': 'Question',
    name: polozka.q,
    acceptedAnswer: { '@type': 'Answer', text: polozka.a },
  })),
};
---

<Base
  title="75 Hard, dopaminový detox a rucking | Buduj sám sebe"
  description="České návody pro 75 Hard, dopaminový detox a rucking. Přehledná pravidla, plány den po dni a tracker na 75 dní v PDF zdarma."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} slot="head" />

  <main>
    <!-- 1 · HERO -->
    <section class="border-b-[3px] border-ink">
      <div class="mx-auto flex max-w-5xl flex-col gap-5 px-5 py-12 sm:px-8">
        <div class="font-mono text-[12px] font-semibold tracking-[0.12em] text-accent">
          ZÁZNAM 001 — ZAČNI DNES
        </div>
        <h1 class="max-w-3xl text-4xl font-bold leading-[1.05] tracking-tight sm:text-[52px]">
          Výzvy s jasným plánem: 75 Hard, dopaminový detox a další.
        </h1>
        <p class="max-w-xl font-mono text-sm leading-relaxed">
          Žádné motivační řeči. Jen pravidla bez nejasností, české návody, rozpis na každý den
          a tracker, který si vytiskneš a odškrtáváš.
        </p>
        <div class="mt-2 flex flex-col gap-2">
          <a
            href="/tracker/"
            class="self-start bg-ink px-6 py-4 font-mono text-sm font-semibold tracking-[0.04em] text-paper hover:bg-accent"
            >STÁHNOUT TRACKER NA 75 DNÍ →</a
          >
          <div class="font-mono text-[12px] text-muted">PDF zdarma za e-mail. Žádný spam.</div>
        </div>
      </div>
    </section>

    <!-- 2 · ZAČNI TADY -->
    <section class="border-b-[3px] border-ink">
      <div class="mx-auto max-w-5xl px-5 py-10 sm:px-8">
        <div class="font-mono text-[12px] tracking-[0.12em] text-muted">ZAČNI TADY</div>
        <h2 class="mt-2 max-w-2xl text-2xl font-bold leading-tight sm:text-[32px]">
          Vyber výzvu podle toho, co chceš právě teď změnit
        </h2>
        <p class="mt-4 max-w-3xl font-mono text-[13px] leading-relaxed text-ink-soft">
          Každá výzva řeší něco jiného. 75 Hard staví na pevných denních pravidlech.
          Dopaminový detox pracuje s telefonem, notifikacemi a rychlými odměnami. Rucking
          mění obyčejnou chůzi v trénink se zátěží. Začni jednou věcí, nastav měřitelný plán
          a teprve potom přidávej další.
        </p>

        <div class="mt-7 overflow-x-auto border-[3px] border-ink">
          <table class="w-full min-w-[680px] border-collapse text-left">
            <thead class="bg-ink font-mono text-[12px] tracking-[0.08em] text-paper">
              <tr>
                <th class="px-4 py-3">VÝZVA</th>
                <th class="px-4 py-3">DÉLKA</th>
                <th class="px-4 py-3">HLAVNÍ ZAMĚŘENÍ</th>
                <th class="px-4 py-3">CO POTŘEBUJEŠ NA START</th>
              </tr>
            </thead>
            <tbody>
              {
                porovnani.map((polozka) => (
                  <tr class="border-b border-line last:border-b-0">
                    <td class="px-4 py-4 text-[16px] font-bold">
                      {polozka.href ? (
                        <a href={polozka.href} class="underline decoration-accent decoration-2 underline-offset-4 hover:text-accent">
                          {polozka.nazev}
                        </a>
                      ) : (
                        polozka.nazev
                      )}
                    </td>
                    <td class="px-4 py-4 font-mono text-[12px] text-ink-soft">{polozka.delka}</td>
                    <td class="px-4 py-4 font-mono text-[12px] text-ink-soft">{polozka.zamer}</td>
                    <td class="px-4 py-4 font-mono text-[12px] text-ink-soft">{polozka.start}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 3 · KALKULAČKA -->
    <section class="border-b-[3px] border-ink bg-paper-dark">
      <div class="mx-auto grid max-w-5xl grid-cols-1 gap-6 px-5 py-10 sm:grid-cols-[1.2fr_1fr] sm:items-center sm:gap-10 sm:px-8">
        <div class="flex flex-col gap-3">
          <div class="font-mono text-[12px] tracking-[0.12em] text-muted">NÁSTROJ ZDARMA</div>
          <h2 class="text-2xl font-bold leading-tight sm:text-[32px]">
            Kolik dní v roce ti sebere telefon?
          </h2>
          <p class="max-w-xl font-mono text-[13px] leading-relaxed text-ink-soft">
            Odhadni si běžný den, kalkulačka to přepočítá na týdny a dny v roce. Nic
            neinstaluješ, nic nevyplňuješ do e-mailu — spočítá se to rovnou v prohlížeči.
          </p>
        </div>
        <div class="flex flex-col items-start gap-2 sm:items-end">
          <a
            href="/nastroje/dopaminovy-rozpocet/"
            class="bg-ink px-6 py-4 font-mono text-sm font-semibold tracking-[0.04em] text-paper hover:bg-accent"
            >SPOČÍTAT DOPAMINOVÝ ROZPOČET →</a
          >
          <div class="font-mono text-[12px] text-muted">Zabere to dvě minuty.</div>
        </div>
      </div>
    </section>

    <!-- 4 · CHECKLIST -->
    <section class="border-b-[3px] border-ink">
      <div class="mx-auto flex max-w-5xl flex-col gap-4 px-5 py-8 sm:px-8">
        <div class="font-mono text-[12px] tracking-[0.12em] text-muted">
          TAKHLE VYPADÁ DEN 1. A DEN 75.
        </div>
        <div class="flex flex-col gap-2.5">
          <CheckItem checked>Drž zvolený jídelníček, bez alkoholu</CheckItem>
          <CheckItem checked>2× 45 minut pohybu, jednou venku</CheckItem>
          <CheckItem>Vypij přibližně 3,8 litru vody</CheckItem>
          <CheckItem>Přečti 10 stran knihy</CheckItem>
          <CheckItem>Vyfoť progresovku</CheckItem>
        </div>
        <div class="mt-1 font-mono text-[13px] leading-relaxed text-muted">
          Pět úkolů. Když jeden vynecháš, jedeš od dne 1. Proto funguje.
        </div>
      </div>
    </section>

    <!-- 5 · MINI-HUBY -->
    <section class="border-b-[3px] border-ink">
      <div class="mx-auto flex max-w-5xl flex-col gap-2 px-5 pt-10 sm:px-8">
        <div class="font-mono text-[12px] tracking-[0.12em] text-muted">REJSTŘÍK VÝZEV</div>
        <h2 class="text-2xl font-bold leading-tight sm:text-[32px]">
          Návody pro 75 Hard, dopaminový detox a rucking
        </h2>
      </div>
      <div class="mx-auto grid max-w-5xl grid-cols-1 pt-6 sm:grid-cols-3">
        {
          huby.map((hub, i) => (
            <div
              class:list={[
                'flex flex-col gap-3 border-t border-line p-6 sm:border-t-0',
                i < huby.length - 1 && 'sm:border-r-[3px] sm:border-r-ink',
              ]}
            >
              <div class="font-mono text-[28px] font-semibold text-accent">{hub.num}</div>
              <div class="text-[19px] font-bold">{hub.title}</div>
              <div class="font-mono text-[12px] leading-relaxed text-ink-soft">{hub.desc}</div>
              {hub.odkazy.length > 0 ? (
                <ul class="mt-1 flex flex-col gap-2 border-t border-line pt-3">
                  {hub.odkazy.map((odkaz) => (
                    <li>
                      <a
                        href={`/vyzvy/${odkaz.slug}/`}
                        class="font-mono text-[13px] leading-snug underline decoration-line decoration-2 underline-offset-4 hover:text-accent hover:decoration-accent"
                      >
                        {odkaz.label}
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <div class="mt-1 border-t border-line pt-3 font-mono text-[13px] text-muted">
                  Články připravujeme.
                </div>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <!-- 6 · TEMATICKÉ VSTUPY -->
    <section class="border-b-[3px] border-ink bg-paper-dark">
      <div class="mx-auto grid max-w-5xl grid-cols-1 sm:grid-cols-3">
        <article class="flex flex-col gap-3 border-b-[3px] border-ink px-5 py-8 sm:border-b-0 sm:border-r-[3px] sm:px-8">
          <div class="font-mono text-[12px] font-semibold tracking-[0.12em] text-accent">PRAVIDLA VÝZVY ČESKY</div>
          <h2 class="text-[22px] font-bold leading-tight">Pravidla výzvy známé jako 75 Hard</h2>
          <p class="font-mono text-[12px] leading-relaxed text-ink-soft">
            Než začneš, projdi si všech pět denních úkolů, pitný režim, pravidla tréninku a
            situace, kvůli kterým se začíná znovu od dne 1.
          </p>
          <div class="mt-auto flex flex-col items-start gap-2 pt-2 font-mono text-[12px] font-semibold">
            <a href="/vyzvy/75-hard-pravidla/" class="underline decoration-accent decoration-2 underline-offset-4 hover:text-accent">PRAVIDLA 75 HARD →</a>
            <a href="/tracker/" class="underline decoration-accent decoration-2 underline-offset-4 hover:text-accent">TRACKER NA 75 DNÍ V PDF →</a>
            <a href="/plany/75-dni/" class="underline decoration-accent decoration-2 underline-offset-4 hover:text-accent">KOMPLETNÍ PLÁN NA 75 DNÍ · 249 KČ →</a>
          </div>
        </article>

        <article class="flex flex-col gap-3 border-b-[3px] border-ink px-5 py-8 sm:border-b-0 sm:border-r-[3px] sm:px-8">
          <div class="font-mono text-[12px] font-semibold tracking-[0.12em] text-accent">DIGITÁLNÍ NÁVYKY</div>
          <h2 class="text-[22px] font-bold leading-tight">Jak na dopaminový detox bez extrémů</h2>
          <p class="font-mono text-[12px] leading-relaxed text-ink-soft">
            Nejde o odstranění dopaminu. Jde o týden, během kterého omezíš automatické
            scrollování, zmapuješ rychlé odměny a nastavíš si udržitelnější digitální návyky.
          </p>
          <div class="mt-auto flex flex-col items-start gap-2 pt-2 font-mono text-[12px] font-semibold">
            <a href="/plany/dopaminovy-detox/" class="underline decoration-accent decoration-2 underline-offset-4 hover:text-accent">7DENNÍ PLÁN DOPAMINOVÉHO DETOXU →</a>
            <a href="/nastroje/dopaminovy-rozpocet/" class="underline decoration-accent decoration-2 underline-offset-4 hover:text-accent">SPOČÍTAT DOPAMINOVÝ ROZPOČET →</a>
          </div>
        </article>

        <article class="flex flex-col gap-3 px-5 py-8 sm:px-8">
          <div class="font-mono text-[12px] font-semibold tracking-[0.12em] text-accent">CHŮZE SE ZÁTĚŽÍ</div>
          <h2 class="text-[22px] font-bold leading-tight">Rucking: jak začít s batohem</h2>
          <p class="font-mono text-[12px] leading-relaxed text-ink-soft">
            Rucking je svižná chůze se zátěží v batohu. Začni lehce, náklad zajisti blízko
            zad a postupně přidávej čas, vzdálenost nebo váhu — vždy jen jednu věc.
          </p>
          <div class="mt-auto border-t border-line pt-3 font-mono text-[12px] text-muted">
            Český průvodce a 12týdenní plán připravujeme.
          </div>
        </article>
      </div>
    </section>

    <!-- 7 · JAK TO FUNGUJE -->
    <section class="border-b-[3px] border-ink">
      <div class="mx-auto flex max-w-5xl flex-col gap-2 px-5 pt-10 sm:px-8">
        <div class="font-mono text-[12px] tracking-[0.12em] text-muted">JAK TO FUNGUJE</div>
        <h2 class="text-2xl font-bold leading-tight sm:text-[32px]">Od rozhodnutí k čárce č. 75</h2>
      </div>
      <div class="mx-auto grid max-w-5xl grid-cols-1 gap-6 px-5 pb-10 pt-6 sm:grid-cols-3 sm:gap-8 sm:px-8">
        {
          kroky.map((krok) => (
            <div class="flex flex-col gap-2">
              <div class="font-mono text-[12px] font-semibold tracking-[0.12em] text-accent">
                {krok.num}
              </div>
              <div class="font-mono text-[15px] font-semibold tracking-[0.08em]">{krok.title}</div>
              <div class="font-mono text-[13px] leading-relaxed text-ink-soft">{krok.desc}</div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 8 · MANIFEST -->
    <section class="border-b-[3px] border-ink bg-ink text-paper">
      <div class="mx-auto flex max-w-5xl flex-col gap-4 px-5 py-12 sm:px-8">
        <div class="font-mono text-[12px] tracking-[0.12em] text-accent-soft">PROČ TENHLE WEB</div>
        <h2 class="max-w-2xl text-2xl font-bold leading-tight sm:text-[32px]">
          Tady nenajdeš citáty se západem slunce.
        </h2>
        <p class="max-w-2xl font-mono text-sm leading-relaxed text-paper-dark">
          Najdeš tu pravidla, checklisty a plány, které drží, i když se ti nechce. Nejsme trenéři
          ani kouči — jsme malá redakce, která překládá světové výzvy do češtiny a dává jim tvar,
          který se dá vytisknout a plnit. Zdroje uvádíme pod každým článkem a placené plány mají
          garanci vrácení peněz.
        </p>
        <a
          href="/o-nas/"
          class="mt-1 self-start font-mono text-[13px] font-semibold tracking-[0.06em] underline decoration-accent decoration-2 underline-offset-4 hover:text-accent-soft"
          >JAK PRACUJEME A S JAKÝMI ZDROJI →</a
        >
      </div>
    </section>

    <!-- 9 · NEJNOVĚJŠÍ ZÁZNAMY -->
    <section class="border-b-[3px] border-ink">
      <div class="mx-auto flex max-w-5xl flex-col gap-2 px-5 pt-10 sm:px-8">
        <div class="font-mono text-[12px] tracking-[0.12em] text-muted">
          POSLEDNÍ ZÁPISY V DENÍKU
        </div>
        <h2 class="text-2xl font-bold leading-tight sm:text-[32px]">Nejnovější články</h2>
      </div>
      <div class="mx-auto flex max-w-5xl flex-col px-5 pb-8 pt-4 sm:px-8">
        {
          nejnovejsi.map((post) => (
            <a
              href={`/vyzvy/${post.id}/`}
              class="group flex flex-col gap-1.5 border-b border-line py-5 hover:bg-paper-dark sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
            >
              <div class="text-[17px] font-bold leading-snug group-hover:text-accent">
                {post.data.title}
              </div>
              <div class="shrink-0 font-mono text-[12px] tracking-[0.08em] text-muted">
                {post.data.kategorie.toUpperCase()} · {post.data.datum}
              </div>
            </a>
          ))
        }
        <a
          href="/vyzvy/"
          class="mt-5 self-start font-mono text-[13px] font-semibold tracking-[0.06em] underline decoration-accent decoration-2 underline-offset-4 hover:text-accent"
          >VŠECHNY VÝZVY →</a
        >
      </div>
    </section>

    <!-- 10 · FAQ -->
    <section class="border-b-[3px] border-ink">
      <div class="mx-auto flex max-w-3xl flex-col gap-4 px-5 py-10 sm:px-8">
        <div class="font-mono text-[12px] tracking-[0.12em] text-muted">RYCHLÉ ODPOVĚDI</div>
        <h2 class="text-2xl font-bold leading-tight sm:text-[32px]">
          Časté otázky o 75 Hard, dopaminovém detoxu a ruckingu
        </h2>
        <div class="flex flex-col">
          {
            faq.map((polozka) => (
              <details class="group border-b border-line py-4">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-[17px] font-bold leading-snug marker:content-none group-open:text-accent">
                  {polozka.q}
                  <span class="mt-0.5 shrink-0 font-mono text-[15px] text-accent group-open:hidden">
                    +
                  </span>
                  <span class="mt-0.5 hidden shrink-0 font-mono text-[15px] text-accent group-open:inline">
                    −
                  </span>
                </summary>
                <p class="mt-3 max-w-2xl font-mono text-[13px] leading-relaxed text-ink-soft">
                  {polozka.a}
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!--
      8 · NEWSLETTER — zatím vypnutý. Newsletter „jednou týdně, co začíná trendovat“ neexistuje,
      tak ho neslibujeme. Až bude první vydání (Ecomail, viz postup-ecomail.md), sekci vrať.
    -->
  </main>
</Base>
